# ─────────────────────────────────────────────
#  ET-AI Content Engine — Environment Variables
#  Copy this file to .env and fill in your keys
#  NEVER commit .env to git
# ─────────────────────────────────────────────

# LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Search
TAVILY_API_KEY=your_tavily_api_key_here
NEWSAPI_KEY=your_newsapi_key_here

# Image generation
STABILITY_API_KEY=your_stability_api_key_here
BYTEZ_API_KEY=your_bytez_api_key_here
BYTEZ_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# Optional: set to "production" in prod
APP_ENV=development

# Fallback LLM (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
